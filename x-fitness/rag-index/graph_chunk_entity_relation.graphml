      <data key="d3">KB-08-chunk-000</data>
      <data key="d2">ข้อมูลส่วนบุคคลเปิดเผยให้เจ้าของข้อมูลเท่านั้น หลังยืนยันตัวตนด้วยรหัสสมาชิกและเบอร์โทร 4 ตัวท้าย</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">KB-08</data>
