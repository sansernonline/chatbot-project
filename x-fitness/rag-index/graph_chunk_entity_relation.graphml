  <data key="d1">method</data>
  <data key="d2">ขั้นตอนที่ผู้ใช้ต้องทำเพื่อเข้าถึงข้อมูลส่วนตัว โดยใช้รหัสสมาชิกและเบอร์โทร 4 ตัวท้าย</data>
  <data key="d3">KB-08-chunk-002</data>
