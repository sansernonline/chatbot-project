  <data key="d1">artifact</data>
  <data key="d2">แพ็กเกจสมาชิกที่มีสัญญา 12 เดือน ต้องแจ้งล่วงหน้า 30 วัน หากยกเลิกก่อนครบสัญญา จะต้องเสียค่าธรรมเนียม 1,500 บาท</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791104232</data>
