      <data key="d1">package</data>
      <data key="d2">แพ็กเกจสมาชิกแบบจ่ายครั้งเดียว 9,900 บาทต่อปี คิดเป็นเฉลี่ยเดือนละ 825 บาท เป็นแพ็กเกจที่คุ้มที่สุด มีสิทธิประโยชน์พิเศษ เช่น วัดองค์ประกอบร่างกายฟรีเดือนละ 1 ครั้ง พาเพื่อนเข้าฟรีเดือนละ 1 ครั้ง และโอนสิทธิ์ให้ผู้อื่นได้ 1 ครั้ง</data>
      <data key="d3">KB-02-chunk-000</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791091121</data>
      <data key="d6" />
    </node>
    <node id="ค่าแรกเข้า">
      <data key="d0">ค่าแรกเข้า</data>
      <data key="d1">fee</data>
      <data key="d2">ค่าธรรมเนียมที่ต้องชำระเมื่อสมัครสมาชิกครั้งแรก&lt;SEP&gt;ค่าธรรมเนียมที่ต้องชำระเมื่อสมัครสมาชิก ขึ้นอยู่กับประเภทแพ็กเกจ เช่น 500 บาทสำหรับแพ็กเกจรายเดือนไม่มีสัญญาและรายเดือนสัญญา 12 เดือน แต่ไม่มีสำหรับแพ็กเกจนักเรียน/นักศึกษาและรายปีจ่ายครั้งเดียว&lt;SEP&gt;ค่าธรรมเนียมที่สมาชิกต้องจ่ายเมื่อสมัครสมาชิกครั้งแรก ซึ่งรวมอยู่ในการคืนเงินหากยกเลิกภายใน 7 วันหลังสมัคร</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001&lt;SEP&gt;KB-05-chunk-000</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="ค่าธรรมเนียมยกเลิก">
      <data key="d0">ค่าธรรมเนียมยกเลิก</data>
      <data key="d1">fee</data>
      <data key="d2">ค่าธรรมเนียมที่ต้องจ่ายหากยกเลิกสมาชิกก่อนครบสัญญา โดยเฉพาะสำหรับแพ็กเกจรายเดือนสัญญา 12 เดือน ซึ่งมีค่าธรรมเนียม 1,500 บาท</data>
      <data key="d3">KB-02-chunk-000</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791091121</data>
      <data key="d6" />
