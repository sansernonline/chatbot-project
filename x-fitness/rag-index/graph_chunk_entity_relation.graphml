  <data key="d0">การพักเพราะเหตุผลทางการแพทย์</data>
  <data key="d1">method</data>
  <data key="d2">รูปแบบการพักสมาชิกที่ไม่มีค่าธรรมเนียม แต่ต้องมีใบรับรองแพทย์ และสามารถพักได้นานสูงสุด 6 เดือน</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791116656</data>
  <data key="d6"></data>
</node>
