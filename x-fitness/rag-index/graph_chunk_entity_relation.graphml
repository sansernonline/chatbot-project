  <graph edgedefault="undirected">
    <node id="เอ็กซ์ ฟิตเนส">
      <data key="d0">เอ็กซ์ ฟิตเนส</data>
      <data key="d1">organization</data>
      <data key="d2">สถานออกกำลังกายที่ให้บริการแพ็กเกจสมาชิกหลายประเภท พร้อมสิทธิ์ในการใช้โซนเวทและคาร์ดิโอไม่จำกัดตามเวลาเปิด-ปิด&lt;SEP&gt;สตูดิโอฟิตเนสขนาดเล็กที่ตั้งอยู่ใจกลางศรีราชา จังหวัดชลบุรี เปิดให้บริการตั้งแต่ปี 2567 โดยเน้นคลาสกลุ่มขนาดเล็ก พร้อมเทรนเนอร์ดูแลใกล้ชิด และบรรยากาศที่เหมาะสำหรับผู้เริ่มต้น</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-01-chunk-000</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-01</data>
      <data key="d5">1791182798</data>
      <data key="d6" />
    </node>
    <node id="บัตรรายวัน">
      <data key="d0">บัตรรายวัน</data>
      <data key="d1">artifact</data>
      <data key="d2">แพ็กเกจสมาชิกแบบรายวันที่มีราคา 150 บาทต่อครั้ง ใช้ได้เฉพาะวันเดียวตามเวลาเปิด-ปิดของสถานที่&lt;SEP&gt;บัตรเข้าใช้บริการศูนย์ออกกำลังกายเพียงวันเดียว ไม่รวมการเข้าคลาส โดยสามารถซื้อเพิ่มคลาสละ 150 บาทที่เคาน์เตอร์&lt;SEP&gt;บัตรเข้าใช้บริการรายวันที่สามารถซื้อเพื่อเข้าร่วมคลาสได้&lt;SEP&gt;สิทธิ์การเข้าใช้ยิมรายวัน ซึ่งไม่สามารถพักสมาชิกได้&lt;SEP&gt;บัตรเข้าใช้บริการรายวันที่มีราคา 150 บาท สำหรับเพื่อนของสมาชิกแพ็กเกจอื่น&lt;SEP&gt;แผนการสมัครสมาชิกแบบรายวัน ซึ่งไม่นับรวมในแคมเปญชวนเพื่อน FRIEND300&lt;SEP&gt;บัตรที่ใช้สำหรับผู้มาใช้บริการรายวัน</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-03-chunk-000&lt;SEP&gt;KB-03-chunk-001&lt;SEP&gt;KB-05-chunk-000&lt;SEP&gt;KB-05-chunk-002&lt;SEP&gt;KB-07-chunk-000&lt;SEP&gt;KB-01-chunk-001</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-03&lt;SEP&gt;KB-05&lt;SEP&gt;KB-07&lt;SEP&gt;KB-01</data>
      <data key="d5">1791182798</data>
      <data key="d6" />
    </node>
    <node id="รายเดือนไม่มีสัญญา">
      <data key="d0">รายเดือนไม่มีสัญญา</data>
      <data key="d1">subscriptionplan</data>
      <data key="d2">แพ็กเกจสมาชิกแบบรายเดือนที่ไม่ต้องมีสัญญา ราคา 1,290 บาทต่อเดือน พร้อมสิทธิ์เข้าคลาสไม่จำกัด&lt;SEP&gt;แพ็กเกจสมาชิกรายเดือนที่ไม่ต้องผูกพันสัญญา ราคา 1,290 บาทต่อเดือน สามารถยกเลิกได้ทุกเมื่อโดยแจ้งล่วงหน้า 30 วัน ไม่มีค่าปรับ และมีค่าแรกเข้า 500 บาท ยกเว้นได้ด้วยโค้ด NOJOIN ถึง 30 พ.ย. 2569&lt;SEP&gt;แผนสมาชิกที่ให้สิทธิ์เข้าร่วมคลาสทุกประเภทได้ไม่จำกัด โดยไม่ต้องเซ็นสัญญา&lt;SEP&gt;แผนการสมัครสมาชิกแบบรายเดือนที่ไม่มีข้อผูกพันสัญญา&lt;SEP&gt;แพ็กเกจสมาชิกแบบรายเดือนที่ไม่มีสัญญา สามารถยกเลิกได้โดยไม่มีค่าปรับ&lt;SEP&gt;แผนการสมัครสมาชิกแบบรายเดือนโดยไม่มีสัญญาผูกพัน</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001&lt;SEP&gt;KB-03-chunk-000&lt;SEP&gt;KB-03-chunk-001&lt;SEP&gt;KB-05-chunk-000&lt;SEP&gt;KB-07-chunk-000</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-03&lt;SEP&gt;KB-05&lt;SEP&gt;KB-07</data>
      <data key="d5">1791178360</data>
      <data key="d6" />
    </node>
    <node id="รายเดือนสัญญา 12 เดือน">
      <data key="d0">รายเดือนสัญญา 12 เดือน</data>
      <data key="d1">content</data>
      <data key="d2">แพ็กเกจสมาชิกแบบรายเดือนที่มีสัญญา 12 เดือน ราคา 990 บาทต่อเดือน พร้อมสิทธิ์เข้าคลาสไม่จำกัด&lt;SEP&gt;แพ็กเกจสมาชิกรายเดือนที่มีสัญญา 12 เดือน ราคา 990 บาทต่อเดือน ต้องใช้บริการต่อเนื่องตลอดสัญญา หากยกเลิกก่อนครบสัญญาจะต้องเสียค่าธรรมเนียม 1,500 บาท และต้องแจ้งล่วงหน้า 30 วัน&lt;SEP&gt;แผนสมาชิกที่ให้สิทธิ์เข้าร่วมคลาสทุกประเภทได้ไม่จำกัด โดยมีสัญญา 12 เดือน&lt;SEP&gt;แผนการสมัครสมาชิกแบบรายเดือนที่มีสัญญา 12 เดือน&lt;SEP&gt;แพ็กเกจสมาชิกแบบรายเดือนที่มีสัญญา 12 เดือน ต้องจ่ายค่าธรรมเนียม 1,500 บาทหากยกเลิกก่อนครบสัญญา</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001&lt;SEP&gt;KB-03-chunk-000&lt;SEP&gt;KB-03-chunk-001&lt;SEP&gt;KB-05-chunk-000</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-03&lt;SEP&gt;KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="นักเรียน/นักศึกษา">
      <data key="d0">นักเรียน/นักศึกษา</data>
      <data key="d1">content</data>
      <data key="d2">แพ็กเกจสมาชิกสำหรับนักเรียนหรือนักศึกษา ราคา 790 บาทต่อเดือน ใช้ได้ 6 เดือน ไม่มีค่าแรกเข้า และไม่รวมคลาส Ride&lt;SEP&gt;บุคคลที่ศึกษาอยู่ในระดับมัธยมปลายหรือมหาวิทยาลัย ได้รับสิทธิ์เข้าร่วมคลาสทั้งหมดยกเว้น Ride (ปั่นจักรยาน)&lt;SEP&gt;บุคคลที่เข้าร่วมกิจกรรมในสถานที่ฝึกอบรมหรือศึกษา ซึ่งได้รับสิทธิพิเศษบางอย่าง&lt;SEP&gt;แพ็กเกจสมาชิกสำหรับนักเรียนหรือนักศึกษา ต้องจ่ายค่าธรรมเนียม 500 บาทหากยกเลิกก่อนครบ 6 เดือน</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-03-chunk-000&lt;SEP&gt;KB-03-chunk-001&lt;SEP&gt;KB-05-chunk-000</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-03&lt;SEP&gt;KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="รายปีจ่ายครั้งเดียว">
      <data key="d0">รายปีจ่ายครั้งเดียว</data>
      <data key="d1">content</data>
      <data key="d2">แพ็กเกจสมาชิกแบบจ่ายครั้งเดียวรายปี ราคา 9,900 บาทต่อปี ใช้ได้ 12 เดือน ไม่มีค่าแรกเข้า และไม่จำกัดสิทธิ์เข้าคลาส&lt;SEP&gt;แพ็กเกจสมาชิกแบบรายปีที่จ่ายครั้งเดียว ไม่สามารถยกเลิกได้หลังเริ่มใช้งาน แต่สามารถโอนสิทธิ์ได้ 1 ครั้ง</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-05-chunk-000</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="ค่าแรกเข้า">
      <data key="d0">ค่าแรกเข้า</data>
      <data key="d1">data</data>
      <data key="d2">ค่าธรรมเนียมที่ต้องชำระครั้งแรกเมื่อสมัครสมาชิก ขึ้นอยู่กับประเภทแพ็กเกจ เช่น 500 บาทสำหรับแพ็กเกจบางประเภท&lt;SEP&gt;ค่าธรรมเนียมแรกเข้าสำหรับสมาชิกใหม่ ราคา 500 บาท ยกเว้นได้ด้วยโค้ด NOJOIN ถึง 30 พ.ย. 2569</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="สิทธิ์คลาส">
      <data key="d0">สิทธิ์คลาส</data>
      <data key="d1">concept</data>
      <data key="d2">สิทธิ์ในการเข้าร่วมคลาสออกกำลังกาย ซึ่งแตกต่างกันไปตามประเภทแพ็กเกจ เช่น ไม่จำกัด ยกเว้นคลาส Ride</data>
      <data key="d3">KB-02-chunk-000</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="ราคาแพ็กเกจ">
      <data key="d0">ราคาแพ็กเกจ</data>
      <data key="d1">data</data>
      <data key="d2">ค่าใช้จ่ายที่กำหนดไว้สำหรับแต่ละประเภทแพ็กเกจสมาชิก ตั้งแต่ 150 บาทต่อครั้ง ไปจนถึง 9,900 บาทต่อปี</data>
      <data key="d3">KB-02-chunk-000</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="เวลาเปิด-ปิด">
      <data key="d0">เวลาเปิด-ปิด</data>
      <data key="d1">concept</data>
      <data key="d2">ช่วงเวลาที่สถานที่ให้บริการเปิดและปิด ซึ่งผู้ใช้บริการต้องปฏิบัติตามเมื่อใช้บริการ&lt;SEP&gt;ช่วงเวลาที่สถานที่ให้บริการเปิดและปิด ซึ่งกำหนดระยะเวลาการใช้บริการของบัตรรายวัน</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="คลาส Ride">
      <data key="d0">คลาส Ride</data>
      <data key="d1">event</data>
      <data key="d2">คลาสออกกำลังกายเฉพาะประเภทที่ไม่รวมอยู่ในสิทธิ์ของแพ็กเกจ "นักเรียน/นักศึกษา"&lt;SEP&gt;คลาสปั่นจักรยานที่มีข้อจำกัดในการเข้าร่วม โดยเฉพาะสำหรับผู้สมัครแพ็กเกจรายเดือนหรือรายปี&lt;SEP&gt;คลาสออกกำลังกายประเภทปั่นจักรยาน ไม่อนุญาตให้นักเรียน/นักศึกษาที่ใช้แพ็กเกจ Student เข้าร่วมได้</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001&lt;SEP&gt;KB-02-chunk-002</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="หนังสือเดินทาง">
      <data key="d0">หนังสือเดินทาง</data>
      <data key="d1">artifact</data>
      <data key="d2">เอกสารประจำตัวที่สามารถใช้แสดงเพื่อเข้าใช้บริการบัตรรายวันได้&lt;SEP&gt;เอกสารเดินทางระหว่างประเทศที่ต้องแสดงเพื่อยืนยันตัวตนในการซื้อบัตรรายวัน</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="บัตรประชาชน">
      <data key="d0">บัตรประชาชน</data>
      <data key="d1">artifact</data>
      <data key="d2">เอกสารประจำตัวที่สามารถใช้แสดงเพื่อเข้าใช้บริการบัตรรายวันได้&lt;SEP&gt;เอกสารประจำตัวประชาชนที่ใช้ยืนยันตัวตนของผู้สมัครทุกคน&lt;SEP&gt;เอกสารประจำตัวพลเมืองที่ต้องแสดงเพื่อยืนยันตัวตนในการซื้อบัตรรายวัน&lt;SEP&gt;เอกสารประจำตัวที่ต้องนำมารับรองตัวตนทั้งผู้โอนและผู้รับโอนในกระบวนการโอนสิทธิ์&lt;SEP&gt;เอกสารประจำตัวที่ใช้ยืนยันตัวตนในการดำเนินการต่าง ๆ เช่น การทำบัตรใหม่หรือเปลี่ยนข้อมูลติดต่อ&lt;SEP&gt;เอกสารประจำตัวที่ใช้ยืนยันตัวตนในการทำธุรกรรมต่าง ๆ</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001&lt;SEP&gt;KB-02-chunk-002&lt;SEP&gt;KB-05-chunk-001&lt;SEP&gt;KB-09-chunk-000&lt;SEP&gt;KB-09-chunk-001</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-05&lt;SEP&gt;KB-09</data>
      <data key="d5">1791178330</data>
      <data key="d6" />
    </node>
    <node id="รายวัน">
      <data key="d0">รายวัน</data>
      <data key="d1">method</data>
      <data key="d2">วิธีการสมัครสมาชิกแบบรายวันที่ใช้บริการได้เพียง 1 วันตามเวลาเปิด-ปิด&lt;SEP&gt;แพ็กเกจเข้าใช้บริการได้ 1 วันตามเวลาเปิด-ปิด ราคา 150 บาท ต้องแสดงบัตรประชาชนหรือหนังสือเดินทางที่เคาน์เตอร์ และสามารถซื้อคลาสเพิ่มได้คลาสละ 150 บาท</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="รายเดือน">
      <data key="d0">รายเดือน</data>
      <data key="d1">method</data>
      <data key="d2">วิธีการสมัครสมาชิกแบบรายเดือนที่แบ่งเป็นหลายรูปแบบ ทั้งแบบมีและไม่มีสัญญา</data>
      <data key="d3">KB-02-chunk-000</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="รายปี">
      <data key="d0">รายปี</data>
      <data key="d1">subscriptionplan</data>
      <data key="d2">วิธีการสมัครสมาชิกแบบจ่ายครั้งเดียวรายปี ที่ครอบคลุมระยะเวลา 12 เดือน&lt;SEP&gt;แผนสมาชิกที่ให้สิทธิ์เข้าร่วมคลาสทุกประเภทได้ไม่จำกัด เป็นระยะเวลา 1 ปี&lt;SEP&gt;แผนการสมัครสมาชิกแบบรายปี&lt;SEP&gt;แผนการสมัครสมาชิกแบบรายปี ที่มีระยะเวลาการใช้งานยาวนานกว่า</data>
      <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-002&lt;SEP&gt;KB-03-chunk-000&lt;SEP&gt;KB-03-chunk-001&lt;SEP&gt;KB-07-chunk-000</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-03&lt;SEP&gt;KB-07</data>
      <data key="d5">1791178360</data>
      <data key="d6" />
    </node>
    <node id="แพ็กเกจนักศึกษา">
      <data key="d0">แพ็กเกจนักศึกษา</data>
      <data key="d1">artifact</data>
      <data key="d2">แพ็กเกจสมาชิกสำหรับนักเรียนและนักศึกษาที่มีราคา 790 บาทต่อเดือน โดยมีข้อจำกัดในการเข้าคลาส Ride (ปั่นจักรยาน) และต้องแสดงบัตรนักเรียนหรือนักศึกษาที่ยังไม่หมดอายุทุกครั้งที่สมัครหรือต่ออายุ&lt;SEP&gt;สิทธิ์การเข้าใช้ยิมสำหรับนักศึกษา ซึ่งไม่สามารถพักสมาชิกได้</data>
      <data key="d3">KB-02-chunk-001&lt;SEP&gt;KB-05-chunk-000</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="Student">
      <data key="d0">Student</data>
      <data key="d1">content</data>
      <data key="d2">แพ็กเกจสมาชิกสำหรับนักเรียนและนักศึกษาอายุ 15–25 ปี ราคา 790 บาทต่อเดือน ต้องแสดงบัตรนักเรียนหรือนักศึกษาที่ยังไม่หมดอายุทุกครั้งที่สมัครหรือต่ออายุ และมีข้อจำกัดในการเข้าคลาส Ride</data>
      <data key="d3">KB-02-chunk-001</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
    </node>
    <node id="ค่าธรรมเนียมยกเลิก">
      <data key="d0">ค่าธรรมเนียมยกเลิก</data>
      <data key="d1">data</data>
      <data key="d2">ค่าธรรมเนียมที่ต้องจ่ายหากยกเลิกสัญญาแบบรายเดือนสัญญา 12 เดือน ก่อนครบสัญญา ราคา 1,500 บาท&lt;SEP&gt;ค่าธรรมเนียมที่ต้องจ่ายหากยกเลิกแผนสมาชิกก่อนครบสัญญา โดยมีข้อกำหนดแตกต่างกันตามประเภทสมาชิกและระยะเวลาที่เหลือ</data>
      <data key="d3">KB-02-chunk-001&lt;SEP&gt;KB-05-chunk-001</data>
      <data key="d4">KB-02&lt;SEP&gt;KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="โค้ด NOJOIN">
      <data key="d0">โค้ด NOJOIN</data>
      <data key="d1">artifact</data>
      <data key="d2">รหัสส่วนลดที่ใช้ยกเว้นค่าแรกเข้า 500 บาท สำหรับแพ็กเกจรายเดือนไม่มีสัญญาและรายเดือนสัญญา 12 เดือน ใช้ได้ถึง 30 พ.ย. 2569</data>
      <data key="d3">KB-02-chunk-001</data>
      <data key="d4">KB-02</data>
      <data key="d5">1791178277</data>
      <data key="d6" />
