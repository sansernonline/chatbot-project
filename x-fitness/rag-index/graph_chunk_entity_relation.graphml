  <data key="d0">ค่าธรรมเนียมการโอนสมาชิก</data>
  <data key="d1">data</data>
  <data key="d2">ค่าธรรมเนียมที่เรียกเก็บสำหรับการโอนสิทธิ์สมาชิก แพ็กเกจรายปีมีค่าธรรมเนียม 500 บาท ส่วนแพ็กเกจ PT ไม่มีค่าธรรมเนียม</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791102449</data>
  <data key="d6"></data>
</node>
<node id="ค่าแรกเข้า">
  <data key="d0">ค่าแรกเข้า</data>
  <data key="d1">data</data>
  <data key="d2">ค่าธรรมเนียมที่จ่ายครั้งแรกเมื่อสมัครสมาชิก ซึ่งจะถูกคืนเต็มจำนวนหากยกเลิกภายใน 7 วันและยังไม่ได้ใช้บริการ&lt;SEP&gt;ค่าธรรมเนียมที่ต้องชำระเมื่อสมัครสมาชิก ขึ้นอยู่กับประเภทแพ็กเกจ เช่น 500 บาทสำหรับแพ็กเกจรายเดือนไม่มีสัญญาและรายเดือนสัญญา 12 เดือน&lt;SEP&gt;ค่าธรรมเนียมเริ่มต้นในการสมัครสมาชิก ราคา 500 บาท ยกเว้นในบางโปรโมชัน&lt;SEP&gt;ค่าธรรมเนียมที่เรียกเก็บในครั้งแรกของการสมัครสมาชิก</data>
  <data key="d3">KB-05-chunk-001&lt;SEP&gt;KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001&lt;SEP&gt;KB-02-chunk-002</data>
  <data key="d4">KB-05&lt;SEP&gt;KB-02</data>
  <data key="d5">1791102734</data>
  <data key="d6"></data>
</node>
<node id="บัตรประชาชน">
  <data key="d0">บัตรประชาชน</data>
  <data key="d1">artifact</data>
  <data key="d2">เอกสารประจำตัวที่ใช้ยืนยันตัวตนและอายุของบุคคล&lt;SEP&gt;เอกสารประจำตัวที่ต้องใช้ในการยืนยันตัวตนของทั้งผู้โอนและผู้รับโอนเมื่อโอนสิทธิ์สมาชิก&lt;SEP&gt;เอกสารประจำตัวที่ต้องใช้ยืนยันตัวตนในการดำเนินการต่าง ๆ&lt;SEP&gt;เอกสารประจำตัวที่ใช้ยืนยันตัวตนเมื่อทำธุรกรรมต่าง ๆ&lt;SEP&gt;เอกสารประจำตัวที่ต้องแสดงเพื่อยืนยันตัวตน&lt;SEP&gt;เอกสารประจำตัวที่ใช้ยืนยันตัวตนในการสมัครและเข้าใช้บริการ&lt;SEP&gt;เอกสารประจำตัวที่ใช้ยืนยันตัวตน</data>
  <data key="d3">KB-05-chunk-001&lt;SEP&gt;KB-05-chunk-002&lt;SEP&gt;KB-09-chunk-000&lt;SEP&gt;KB-09-chunk-001&lt;SEP&gt;KB-02-chunk-001&lt;SEP&gt;KB-02-chunk-002&lt;SEP&gt;KB-02-chunk-003&lt;SEP&gt;KB-02-chunk-000</data>
  <data key="d4">KB-05&lt;SEP&gt;KB-09&lt;SEP&gt;KB-02</data>
  <data key="d5">1791102734</data>
  <data key="d6"></data>
</node>
