  <data key="d5">1791116656</data>
  <data key="d6"></data>
</node>
<node id="รายวัน">
  <data key="d0">รายวัน</data>
  <data key="d1">content</data>
  <data key="d2">แพ็กเกจเข้าใช้บริการ 1 วัน โดยต้องแสดงบัตรประชาชนหรือหนังสือเดินทาง ราคา 150 บาท และสามารถซื้อคลาสเพิ่มได้คลาสละ 150 บาท</data>
  <data key="d3">KB-02-chunk-001</data>
  <data key="d4">KB-02</data>
