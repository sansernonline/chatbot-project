  <data key="d1">artifact</data>
  <data key="d2">ประเภทแพ็กเกจสมาชิกที่มีสัญญา 12 เดือน ต้องแจ้งยกเลิกล่วงหน้า 30 วัน และเสียค่าธรรมเนียม 1,500 บาท หากยังไม่ครบสัญญา</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
