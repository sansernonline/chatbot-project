      <data key="d3">KB-04-chunk-000</data>
      <data key="d2">แพ็กเกจ PT สามารถโอนให้สมาชิกคนอื่นได้ 1 ครั้งโดยไม่มีค่าธรรมเนียม</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">KB-04</data>
      <data key="d5">1791091192</data>
      <data key="d6" />
    </node>
    <node id="การพักสมาชิก">
      <data key="d0">การพักสมาชิก</data>
      <data key="d1">policy</data>
      <data key="d2">นโยบายที่อนุญาตให้สมาชิกหยุดใช้บริการชั่วคราวเป็นระยะเวลา 1–3 เดือนต่อครั้ง โดยรวมไม่เกิน 3 เดือนต่อปี พร้อมมีค่าธรรมเนียม 100 บาทต่อเดือน ยกเว้นกรณีพักเพราะเหตุผลทางการแพทย์ที่ไม่มีค่าธรรมเนียมและสามารถพักได้สูงสุด 6 เดือน</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="การยกเลิกสมาชิก">
      <data key="d0">การยกเลิกสมาชิก</data>
      <data key="d1">policy</data>
      <data key="d2">นโยบายที่กำหนดเงื่อนไขการยกเลิกสมาชิกตามประเภทแพ็กเกจ เช่น รายเดือนไม่มีสัญญา รายเดือนสัญญา 12 เดือน นักเรียน/นักศึกษา และรายปีจ่ายครั้งเดียว พร้อมระบุค่าธรรมเนียมและระยะเวลาแจ้งล่วงหน้า</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="การคืนเงิน">
      <data key="d0">การคืนเงิน</data>
      <data key="d1">policy</data>
      <data key="d2">นโยบายที่ระบุเงื่อนไขการคืนเงินสมาชิก ซึ่งสามารถคืนเต็มจำนวนได้เฉพาะกรณียกเลิกภายใน 7 วันหลังสมัครและยังไม่เคยใช้บริการ รวมถึงข้อจำกัดสำหรับแพ็กเกจเทรนเนอร์ส่วนตัวที่ไม่สามารถคืนเงินได้</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="การโอนสิทธิ์สมาชิก">
      <data key="d0">การโอนสิทธิ์สมาชิก</data>
      <data key="d1">policy</data>
      <data key="d2">นโยบายที่อนุญาตให้โอนสิทธิ์สมาชิกได้ 1 ครั้งสำหรับแพ็กเกจรายปีและแพ็กเกจเทรนเนอร์ส่วนตัว โดยต้องดำเนินการที่เคาน์เตอร์พร้อมบัตรประชาชนของทั้งผู้โอนและผู้รับโอน และมีค่าธรรมเนียมเฉพาะการโอนรายปี</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="การต่ออายุ">
      <data key="d0">การต่ออายุ</data>
      <data key="d1">policy</data>
      <data key="d2">นโยบายที่อนุญาตให้สมาชิกต่ออายุสมาชิกได้ล่วงหน้า 30 วันก่อนหมดอายุ โดยราคาตามแพ็กเกจปัจจุบัน และสมาชิกที่หมดอายุไม่เกิน 30 วันสามารถต่ออายุโดยไม่ต้องจ่ายค่าแรกเข้าใหม่</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="การพาเพื่อน">
      <data key="d0">การพาเพื่อน</data>
      <data key="d1">policy</data>
      <data key="d2">นโยบายที่อนุญาตให้สมาชิกพาเพื่อนเข้าใช้บริการ โดยสมาชิกรายปีสามารถพาเพื่อนเข้าฟรีเดือนละ 1 ครั้ง ส่วนสมาชิกแพ็กเกจอื่นต้องให้เพื่อนซื้อบัตรรายวันราคา 150 บาท และต้องมีอายุไม่ต่ำกว่า 15 ปีพร้อมแสดงบัตรประชาชน</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="ค่าธรรมเนียมการพัก">
      <data key="d0">ค่าธรรมเนียมการพัก</data>
      <data key="d1">fee</data>
      <data key="d2">ค่าธรรมเนียม 100 บาทต่อเดือนที่สมาชิกต้องชำระเมื่อแจ้งพักสมาชิก ยกเว้นกรณีพักเพราะเหตุผลทางการแพทย์ที่ไม่มีค่าธรรมเนียม</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="ค่าธรรมเนียมการยกเลิก">
      <data key="d0">ค่าธรรมเนียมการยกเลิก</data>
      <data key="d1">fee</data>
      <data key="d2">ค่าธรรมเนียมที่ต้องจ่ายเมื่อยกเลิกสมาชิก ขึ้นอยู่กับประเภทแพ็กเกจ เช่น 1,500 บาท สำหรับรายเดือนสัญญา 12 เดือน และ 500 บาท สำหรับนักเรียน/นักศึกษา หากยังไม่ครบ 6 เดือน</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="ค่าธรรมเนียมการโอนสิทธิ์">
      <data key="d0">ค่าธรรมเนียมการโอนสิทธิ์</data>
      <data key="d1">fee</data>
      <data key="d2">ค่าธรรมเนียม 500 บาท สำหรับการโอนสิทธิ์สมาชิกรายปี ขณะที่การโอนสิทธิ์แพ็กเกจเทรนเนอร์ส่วนตัวไม่มีค่าธรรมเนียม</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="รายเดือนไม่มีสัญญา">
      <data key="d0">รายเดือนไม่มีสัญญา</data>
      <data key="d1">membershippackage</data>
      <data key="d2">แพ็กเกจสมาชิกแบบรายเดือนที่ไม่มีสัญญา สามารถยกเลิกได้โดยแจ้งล่วงหน้า 30 วัน และไม่มีค่าปรับ</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="รายเดือนสัญญา 12 เดือน">
      <data key="d0">รายเดือนสัญญา 12 เดือน</data>
      <data key="d1">membershippackage</data>
      <data key="d2">แพ็กเกจสมาชิกแบบรายเดือนที่มีสัญญา 12 เดือน ต้องแจ้งล่วงหน้า 30 วัน หากยกเลิกก่อนครบสัญญา จะต้องเสียค่าธรรมเนียม 1,500 บาท</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="นักเรียน/นักศึกษา">
      <data key="d0">นักเรียน/นักศึกษา</data>
      <data key="d1">membershippackage</data>
      <data key="d2">แพ็กเกจสมาชิกสำหรับนักเรียนและนักศึกษา ต้องแจ้งล่วงหน้า 30 วัน หากยกเลิกก่อนครบ 6 เดือน จะต้องเสียค่าธรรมเนียม 500 บาท</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="รายปีจ่ายครั้งเดียว">
      <data key="d0">รายปีจ่ายครั้งเดียว</data>
      <data key="d1">membershippackage</data>
      <data key="d2">แพ็กเกจสมาชิกแบบจ่ายครั้งเดียวรายปี ไม่สามารถยกเลิกได้หลังเริ่มใช้งาน แต่อนุญาตให้โอนสิทธิ์ได้ 1 ครั้ง</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791091254</data>
      <data key="d6" />
    </node>
    <node id="แพ็กเกจเทรนเนอร์ส่วนตัว">
