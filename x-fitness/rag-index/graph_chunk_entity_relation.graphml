  <data key="d1">person</data>
  <data key="d2">กลุ่มบุคคลที่ต้องมีผู้ปกครองเซ็นยินยอมในการสมัครสมาชิก</data>
  <data key="d3">KB-02-chunk-002&lt;SEP&gt;KB-02-chunk-001</data>
