      <data key="d0">ผลการวัดร่างกาย</data>
      <data key="d1">data</data>
      <data key="d2">ข้อมูลที่ได้จากการใช้เครื่อง InBody ซึ่งประกอบด้วยน้ำหนัก มวลกล้ามเนื้อ เปอร์เซ็นต์ไขมัน ฯลฯ</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="ภาพผลวัดร่างกาย">
      <data key="d0">ภาพผลวัดร่างกาย</data>
      <data key="d1">content</data>
      <data key="d2">ภาพถ่ายหรือไฟล์ข้อมูลที่แสดงผลการวัดองค์ประกอบร่างกาย ถูกส่งให้แชตบอทเพื่อวิเคราะห์</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="สลิป">
      <data key="d0">สลิป</data>
      <data key="d1">content</data>
      <data key="d2">เอกสารหรือภาพถ่ายที่แสดงการชำระเงิน ซึ่งอาจถูกส่งผ่านแชตเพื่อการตรวจสอบ</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
