  <data key="d1">event</data>
  <data key="d2">กรณีที่สมาชิกไม่สามารถออกกำลังกายได้ถาวรเนื่องจากปัญหาสุขภาพ ซึ่งได้รับการยกเว้นค่าธรรมเนียมการยกเลิก</data>
  <data key="d3">KB-05-chunk-000</data>
