    <node id="กฎการใช้ยิม">
      <data key="d0">กฎการใช้ยิม</data>
      <data key="d1">concept</data>
      <data key="d2">แนวทางและข้อกำหนดที่กำหนดการใช้งานยิม ครอบคลุมการแต่งกาย มารยาท พฤติกรรมในพื้นที่ และการใช้สิ่งอำนวยความสะดวก</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="การแต่งกาย">
      <data key="d0">การแต่งกาย</data>
      <data key="d1">method</data>
      <data key="d2">ข้อกำหนดเกี่ยวกับการแต่งกายที่เหมาะสมในแต่ละโซนของยิม เช่น รองเท้าผ้าใบหุ้มส้นในโซนเวทและคาร์ดิโอ หรือการสวมเสื้อที่มีแขน</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="มารยาทในยิม">
      <data key="d0">มารยาทในยิม</data>
      <data key="d1">concept</data>
      <data key="d2">พฤติกรรมที่ควรปฏิบัติตามเพื่อรักษาความเรียบร้อยและความปลอดภัยในยิม เช่น การเช็ดเครื่องหลังใช้ การเก็บอุปกรณ์ให้เรียบร้อย และการไม่ถ่ายภาพผู้อื่นโดยไม่ได้รับอนุญาต</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="ข้อมูลส่วนบุคคล">
      <data key="d0">ข้อมูลส่วนบุคคล</data>
      <data key="d1">concept</data>
      <data key="d2">ข้อมูลที่เก็บรวบรวมจากสมาชิกเพื่อการบริหารจัดการ และการปฏิบัติตามกฎหมายคุ้มครองข้อมูลส่วนบุคคล</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
