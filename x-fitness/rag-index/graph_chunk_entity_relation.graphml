  <data key="d0">ชลบุรี</data>
  <data key="d1">location</data>
  <data key="d2">จังหวัดที่ตั้งของอำเภอศรีราชา ซึ่งเป็นที่ตั้งของเอ็กซ์ ฟิตเนส</data>
  <data key="d3">KB-01-chunk-000</data>
