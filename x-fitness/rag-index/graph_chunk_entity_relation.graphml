</node>
<node id="แพ็กเกจนักเรียน/นักศึกษา">
  <data key="d0">แพ็กเกจนักเรียน/นักศึกษา</data>
  <data key="d1">content</data>
  <data key="d2">แพ็กเกจสมาชิกสำหรับนักเรียนหรือนักศึกษา ต้องแจ้งล่วงหน้า 30 วัน และจ่ายค่าธรรมเนียมยกเลิก 500 บาท หากยังไม่ครบ 6 เดือน</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="แพ็กเกจรอบปีจ่ายครั้งเดียว">
  <data key="d0">แพ็กเกจรอบปีจ่ายครั้งเดียว</data>
  <data key="d1">content</data>
  <data key="d2">แพ็กเกจสมาชิกที่ชำระเงินครั้งเดียวต่อปี ไม่สามารถยกเลิกได้หลังเริ่มใช้งาน แต่สามารถโอนสิทธิ์ได้เพียง 1 ครั้ง</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ค่าธรรมเนียมยกเลิก 1,500 บาท">
  <data key="d0">ค่าธรรมเนียมยกเลิก 1,500 บาท</data>
  <data key="d1">data</data>
  <data key="d2">ค่าธรรมเนียมที่ต้องจ่ายหากยกเลิกแพ็กเกจรายเดือนสัญญา 12 เดือน ก่อนครบสัญญา</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ค่าธรรมเนียมยกเลิก 500 บาท">
  <data key="d0">ค่าธรรมเนียมยกเลิก 500 บาท</data>
  <data key="d1">data</data>
  <data key="d2">ค่าธรรมเนียมที่ต้องจ่ายหากยกเลิกแพ็กเกจนักเรียน/นักศึกษา ก่อนครบ 6 เดือน</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="แพ็กเกจนักศึกษา">
  <data key="d0">แพ็กเกจนักศึกษา</data>
  <data key="d1">artifact</data>
  <data key="d2">แพ็กเกจสมาชิกสำหรับนักศึกษา ไม่สามารถพักสมาชิกได้</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="วันหมดอายุ">
  <data key="d0">วันหมดอายุ</data>
  <data key="d1">data</data>
  <data key="d2">วันที่สิทธิ์การใช้บริการของสมาชิกสิ้นสุดลง ซึ่งจะเลื่อนออกไปเท่ากับจำนวนวันที่พักสมาชิก</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การแจ้งผ่านแชต">
  <data key="d0">การแจ้งผ่านแชต</data>
  <data key="d1">method</data>
  <data key="d2">ช่องทางการแจ้งพักสมาชิกผ่านระบบแชต ต้องยืนยันตัวตนก่อน</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การโอนสิทธิ์ได้ 1 ครั้ง">
  <data key="d0">การโอนสิทธิ์ได้ 1 ครั้ง</data>
  <data key="d1">method</data>
  <data key="d2">ข้อจำกัดในการโอนสิทธิ์ของแพ็กเกจรอบปีจ่ายครั้งเดียว ที่สามารถโอนได้เพียงครั้งเดียว</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การโอนสิทธิ์สมาชิก">
  <data key="d0">การโอนสิทธิ์สมาชิก</data>
  <data key="d1">method</data>
  <data key="d2">กระบวนการโอนสิทธิ์การเป็นสมาชิกให้ผู้อื่น โดยมีข้อจำกัดด้านจำนวนครั้งและเอกสารที่ต้องใช้</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การต่ออายุสมาชิก">
  <data key="d0">การต่ออายุสมาชิก</data>
  <data key="d1">method</data>
  <data key="d2">กระบวนการต่ออายุแผนสมาชิกก่อนหมดอายุหรือหลังหมดอายุภายใน 30 วัน โดยไม่ต้องจ่ายค่าแรกเข้าใหม่</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การพาเพื่อน">
  <data key="d0">การพาเพื่อน</data>
  <data key="d1">method</data>
  <data key="d2">กิจกรรมที่สมาชิกสามารถพาผู้อื่นเข้าใช้บริการได้ตามเงื่อนไขของแต่ละแพ็กเกจ&lt;SEP&gt;สิทธิพิเศษสำหรับสมาชิกรายปีในการพาเพื่อนมาใช้บริการฟรีเดือนละ 1 ครั้ง หรือสมาชิกแพ็กเกจอื่นที่พาเพื่อนต้องซื้อบัตรรายเดือน</data>
  <data key="d3">KB-05-chunk-001&lt;SEP&gt;KB-05-chunk-002</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="แพ็กเกจเทรนเนอร์ส่วนตัว">
  <data key="d0">แพ็กเกจเทรนเนอร์ส่วนตัว</data>
  <data key="d1">artifact</data>
  <data key="d2">แผนสมาชิกที่รวมบริการเทรนเนอร์ส่วนตัว ไม่สามารถคืนเงินได้ แต่สามารถโอนสิทธิ์ได้ 1 ครั้ง</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ค่าธรรมเนียมโอนสมาชิก">
  <data key="d0">ค่าธรรมเนียมโอนสมาชิก</data>
  <data key="d1">data</data>
  <data key="d2">ค่าธรรมเนียมที่ต้องจ่ายเมื่อมีการโอนสิทธิ์สมาชิก สำหรับแพ็กเกจรูปแบบรายปีคือ 500 บาท ส่วนแพ็กเกจ PT ไม่มีค่าธรรมเนียม</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การอนุมัติการคืนเงิน">
  <data key="d0">การอนุมัติการคืนเงิน</data>
  <data key="d1">concept</data>
  <data key="d2">กระบวนการที่ต้องได้รับการอนุมัติจากผู้จัดการสาขาเท่านั้น บอทแชทไม่สามารถอนุมัติการคืนเงินได้</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="หลักฐานการย้ายที่อยู่">
  <data key="d0">หลักฐานการย้ายที่อยู่</data>
  <data key="d1">artifact</data>
  <data key="d2">เอกสารที่ต้องแสดงเพื่อยืนยันการย้ายที่อยู่ห่างเกิน 30 กิโลเมตร เพื่อขอรับการยกเว้นค่าธรรมเนียม</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="หลักฐานทางการแพทย์">
  <data key="d0">หลักฐานทางการแพทย์</data>
  <data key="d1">artifact</data>
  <data key="d2">เอกสารที่ต้องแสดงเพื่อยืนยันว่ามีภาวะสุขภาพที่ทำให้ไม่สามารถออกกำลังกายได้ถาวร เพื่อขอรับการยกเว้นค่าธรรมเนียม</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ช่องทางการชำระเงิน">
  <data key="d0">ช่องทางการชำระเงิน</data>
  <data key="d1">artifact</data>
  <data key="d2">ช่องทางที่ใช้ในการชำระเงิน ซึ่งจะเป็นช่องทางเดียวกันที่ใช้ในการคืนเงิน</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ผู้จัดการสาขา">
  <data key="d0">ผู้จัดการสาขา</data>
  <data key="d1">person</data>
  <data key="d2">บุคคลที่มีอำนาจอนุมัติการคืนเงินและการดำเนินการบางอย่างที่เกี่ยวข้องกับสมาชิก</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="บอทแชท">
  <data key="d0">บอทแชท</data>
  <data key="d1">artifact</data>
  <data key="d2">ระบบแชทอัตโนมัติที่สามารถบันทึกคำขอคืนเงินและส่งต่อไปยังพนักงาน แต่ไม่มีอำนาจอนุมัติ</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="สมาชิกรายปี">
  <data key="d0">สมาชิกรายปี</data>
  <data key="d1">person</data>
  <data key="d2">สมาชิกที่สมัครใช้บริการแบบรายปี ซึ่งมีสิทธิพาเพื่อนเข้าฟรีเดือนละ 1 ครั้ง&lt;SEP&gt;บุคคลที่สมัครสมาชิกแบบรายปี ซึ่งมีสิทธิ์พาเพื่อนเข้าใช้บริการฟรีเดือนละ 1 ครั้ง&lt;SEP&gt;สมาชิกที่สมัครสมาชิกรายปี ซึ่งได้รับสิทธิ์ฟรีเดือนละ 1 ครั้งในการวัดองค์ประกอบร่างกาย</data>
  <data key="d3">KB-05-chunk-001&lt;SEP&gt;KB-05-chunk-002&lt;SEP&gt;KB-08-chunk-001</data>
  <data key="d4">KB-05&lt;SEP&gt;KB-08</data>
  <data key="d5">1791142755</data>
  <data key="d6"></data>
</node>
<node id="สมาชิกแพ็กเกจอื่น">
  <data key="d0">สมาชิกแพ็กเกจอื่น</data>
  <data key="d1">person</data>
  <data key="d2">สมาชิกที่สมัครใช้บริการในแพ็กเกจอื่นนอกเหนือจากแพ็กเกจรายปี ซึ่งสามารถพาเพื่อนเข้าได้หากเพื่อนซื้อบัตรรายวัน&lt;SEP&gt;บุคคลที่สมัครสมาชิกในแพ็กเกจอื่นนอกเหนือจากแพ็กเกจรูปแบบรายปี ซึ่งสามารถพาเพื่อนมาใช้บริการได้หากเพื่อนซื้อบัตรรายเดือน</data>
  <data key="d3">KB-05-chunk-001&lt;SEP&gt;KB-05-chunk-002</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ผู้โอน">
  <data key="d0">ผู้โอน</data>
  <data key="d1">person</data>
  <data key="d2">บุคคลที่ประสงค์จะโอนสิทธิ์การเป็นสมาชิกให้ผู้อื่น</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ผู้รับโอน">
  <data key="d0">ผู้รับโอน</data>
  <data key="d1">person</data>
  <data key="d2">บุคคลที่ได้รับสิทธิ์การเป็นสมาชิกจากการโอนจากผู้อื่น</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ระยะเวลา 7 วัน">
  <data key="d0">ระยะเวลา 7 วัน</data>
  <data key="d1">data</data>
  <data key="d2">ช่วงเวลาที่กำหนดไว้สำหรับการขอคืนเงินเต็มจำนวน ตั้งแต่วันที่สมัครจนถึงวันที่ครบ 7 วัน โดยยังไม่เคยเข้าใช้บริการ</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ระยะเวลา 14 วันทำการ">
  <data key="d0">ระยะเวลา 14 วันทำการ</data>
  <data key="d1">data</data>
  <data key="d2">ช่วงเวลาที่ใช้ในการดำเนินการคืนเงินหลังจากได้รับคำขอ</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ระยะเวลา 30 วัน">
  <data key="d0">ระยะเวลา 30 วัน</data>
  <data key="d1">data</data>
  <data key="d2">ช่วงเวลาที่กำหนดไว้สำหรับการต่ออายุสมาชิกล่วงหน้า และยังคงสามารถต่ออายุได้หากหมดอายุไม่เกิน 30 วัน</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="ระยะทาง 30 กิโลเมตร">
  <data key="d0">ระยะทาง 30 กิโลเมตร</data>
  <data key="d1">data</data>
  <data key="d2">ระยะทางที่ใช้เป็นเกณฑ์ในการพิจารณาเหตุผลการยกเลิกสมาชิกเนื่องจากการย้ายที่อยู่</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การเข้าใช้บริการ">
  <data key="d0">การเข้าใช้บริการ</data>
  <data key="d1">concept</data>
  <data key="d2">สถานะที่บ่งชี้ว่าสมาชิกได้เริ่มใช้บริการใด ๆ แล้ว ซึ่งส่งผลต่อการคืนเงิน</data>
  <data key="d3">KB-05-chunk-001</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การต่ออายุ">
  <data key="d0">การต่ออายุ</data>
  <data key="d1">method</data>
  <data key="d2">กระบวนการต่ออายุสมาชิกที่สามารถทำได้ล่วงหน้า 30 วันก่อนหมดอายุ โดยราคาจะเป็นตามแพ็กเกจปัจจุบัน</data>
  <data key="d3">KB-05-chunk-002</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="การต่ออายุโดยไม่ต้องจ่ายค่าแรกเข้า">
  <data key="d0">การต่ออายุโดยไม่ต้องจ่ายค่าแรกเข้า</data>
  <data key="d1">method</data>
  <data key="d2">กระบวนการต่ออายุสมาชิกที่หมดอายุไม่เกิน 30 วัน โดยไม่ต้องชำระค่าแรกเข้าใหม่</data>
  <data key="d3">KB-05-chunk-002</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791142532</data>
  <data key="d6"></data>
</node>
<node id="เพื่อน">
  <data key="d0">เพื่อน</data>
  <data key="d1">person</data>
  <data key="d2">บุคคลที่ถูกพาเข้าใช้บริการโดยสมาชิก ต้องมีอายุ 15 ปีขึ้นไปและแสดงบัตรประชาชน&lt;SEP&gt;บุคคลที่ถูกแนะนำให้สมัครสมาชิก และต้องชำระเงินเพื่อให้ผู้ชวนได้รับแต้ม</data>
  <data key="d3">KB-05-chunk-002&lt;SEP&gt;KB-07-chunk-000</data>
