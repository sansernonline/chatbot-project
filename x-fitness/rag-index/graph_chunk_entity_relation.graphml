      <data key="d1">event</data>
      <data key="d2">กิจกรรมการออกกำลังกายกลุ่ม เช่น โยคะ พิลาทิส และมวยไทย ที่จัดขึ้นในยิม</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="การออกกำลังกาย">
      <data key="d0">การออกกำลังกาย</data>
      <data key="d1">concept</data>
      <data key="d2">กิจกรรมทางกายภาพที่ทำเพื่อสุขภาพและฟิตเนส ซึ่งมีข้อจำกัดและคำแนะนำเฉพาะสำหรับผู้ที่มีภาวะสุขภาพพิเศษ</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="การใช้เครื่องคาร์ดิโอ">
      <data key="d0">การใช้เครื่องคาร์ดิโอ</data>
      <data key="d1">method</data>
      <data key="d2">ข้อจำกัดในการใช้เครื่องคาร์ดิโอในช่วงเวลาที่มีผู้ใช้มาก เช่น ไม่เกิน 30 นาทีต่อครั้ง</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="การแจ้งเหตุฉุกเฉิน">
      <data key="d0">การแจ้งเหตุฉุกเฉิน</data>
      <data key="d1">method</data>
      <data key="d2">ขั้นตอนการขอความช่วยเหลือในกรณีฉุกเฉิน เช่น การโทร 1669 หรือการแจ้งพนักงาน</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="การเปิดเผยข้อมูล">
      <data key="d0">การเปิดเผยข้อมูล</data>
      <data key="d1">concept</data>
      <data key="d2">นโยบายการควบคุมการเข้าถึงข้อมูลส่วนบุคคลของสมาชิก โดยเฉพาะการไม่เปิดเผยข้อมูลให้บุคคลภายนอก</data>
      <data key="d3">KB-08-chunk-000</data>
