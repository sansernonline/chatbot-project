  <data key="d6"></data>
</node>
<node id="ค่าแรกเข้า">
  <data key="d0">ค่าแรกเข้า</data>
  <data key="d1">data</data>
  <data key="d2">ค่าธรรมเนียมที่ต้องชำระครั้งแรกเมื่อสมัครสมาชิก ขึ้นอยู่กับประเภทแพ็กเกจ เช่น 500 บาทสำหรับแพ็กเกจบางประเภท&lt;SEP&gt;ค่าธรรมเนียมเริ่มต้นในการสมัครสมาชิกรายเดือน ราคา 500 บาท ยกเว้นได้ด้วยโค้ด NOJOIN ถึง 30 พ.ย. 2569</data>
  <data key="d3">KB-02-chunk-000&lt;SEP&gt;KB-02-chunk-001</data>
  <data key="d4">KB-02</data>
  <data key="d5">1791142161</data>
  <data key="d6"></data>
</node>
<node id="สิทธิ์คลาส">
  <data key="d0">สิทธิ์คลาส</data>
  <data key="d1">concept</data>
  <data key="d2">สิทธิ์ในการเข้าร่วมคลาสออกกำลังกาย ซึ่งแตกต่างกันไปตามประเภทแพ็กเกจ เช่น ไม่จำกัด ยกเว้นคลาส Ride</data>
  <data key="d3">KB-02-chunk-000</data>
  <data key="d4">KB-02</data>
  <data key="d5">1791142161</data>
  <data key="d6"></data>
</node>
<node id="ราคาแพ็กเกจ">
  <data key="d0">ราคาแพ็กเกจ</data>
  <data key="d1">data</data>
  <data key="d2">ค่าใช้จ่ายที่กำหนดไว้สำหรับแต่ละประเภทแพ็กเกจสมาชิก ตั้งแต่ 150 บาทต่อครั้ง ไปจนถึง 9,900 บาทต่อปี</data>
  <data key="d3">KB-02-chunk-000</data>
  <data key="d4">KB-02</data>
