  <data key="d1">artifact</data>
  <data key="d2">แพ็กเกจสมาชิกสำหรับนักเรียนหรือนักศึกษา ต้องแจ้งล่วงหน้า 30 วัน หากยกเลิกก่อนครบ 6 เดือน จะต้องเสียค่าธรรมเนียม 500 บาท</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791104232</data>
