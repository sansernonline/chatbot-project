  <data key="d1">content</data>
  <data key="d2">ประเภทแพ็กเกจสมาชิกที่มีสัญญา 12 เดือน ต้องเสียค่าธรรมเนียม 1,500 บาทหากยกเลิกก่อนครบสัญญา</data>
  <data key="d3">KB-05-chunk-000</data>
  <data key="d4">KB-05</data>
