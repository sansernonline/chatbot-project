  <data key="d1">method</data>
  <data key="d2">โปรโมชันสำหรับสมาชิกที่สามารถพาเพื่อนเข้าใช้บริการได้ตามเงื่อนไขของแต่ละแพ็กเกจ&lt;SEP&gt;สิทธิพิเศษที่สมาชิกสามารถพาเพื่อนมาใช้บริการฟรีได้ตามจำนวนครั้งที่กำหนด</data>
  <data key="d3">KB-05-chunk-001&lt;SEP&gt;KB-05-chunk-002</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791116656</data>
  <data key="d6"></data>
</node>
