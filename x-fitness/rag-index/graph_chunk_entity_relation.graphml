      <data key="d0">ความปลอดภัยและสุขภาพ</data>
      <data key="d1">concept</data>
      <data key="d2">มาตรการและคำแนะนำเพื่อความปลอดภัยในการออกกำลังกาย โดยเฉพาะสำหรับผู้มีโรคประจำตัว ตั้งครรภ์ หรือผู้ที่เพิ่งผ่าตัด</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="เครื่องกระตุกหัวใจไฟฟ้าอัตโนมัติ (AED)">
      <data key="d0">เครื่องกระตุกหัวใจไฟฟ้าอัตโนมัติ (AED)</data>
      <data key="d1">artifact</data>
      <data key="d2">อุปกรณ์ช่วยชีวิตฉุกเฉินที่ติดตั้งอยู่ที่เคาน์เตอร์ยิม และพนักงานผ่านการอบรมการใช้งาน</data>
