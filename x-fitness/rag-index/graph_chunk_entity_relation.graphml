    <node id="ไม่สามารถวินิจฉัยโรคหรือสั่งยาได้">
      <data key="d0">ไม่สามารถวินิจฉัยโรคหรือสั่งยาได้</data>
      <data key="d3">KB-04-chunk-002</data>
      <data key="d2">โค้ชไม่มีสิทธิ์ในการวินิจฉัยโรคหรือสั่งยาใด ๆ</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">KB-04</data>
      <data key="d5">1791178278</data>
      <data key="d6" />
    </node>
    <node id="การพักสมาชิก">
      <data key="d0">การพักสมาชิก</data>
      <data key="d1">policy</data>
      <data key="d2">การหยุดใช้สิทธิ์สมาชิกชั่วคราวตามนโยบายขององค์กร โดยแบ่งเป็นสองประเภท ได้แก่ การพักแบบปกติและพักเพราะเหตุผลทางการแพทย์</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="การยกเลิกสมาชิก">
      <data key="d0">การยกเลิกสมาชิก</data>
      <data key="d1">policy</data>
      <data key="d2">กระบวนการที่สมาชิกสามารถยกเลิกแผนสมาชิกได้ภายใต้เงื่อนไขเฉพาะ เช่น แจ้งล่วงหน้า 30 วัน หรือมีเหตุผลพิเศษเช่น การย้ายที่อยู่หรือปัญหาสุขภาพ&lt;SEP&gt;การระงับสิทธิ์สมาชิกถาวรตามเงื่อนไขที่กำหนดไว้ในแต่ละแพ็กเกจสมาชิก</data>
      <data key="d3">KB-05-chunk-000&lt;SEP&gt;KB-05-chunk-001</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="การพักแบบปกติ">
      <data key="d0">การพักแบบปกติ</data>
      <data key="d1">method</data>
      <data key="d2">การพักสมาชิกที่สามารถทำได้นานสุด 3 เดือนต่อปี ต้องเสียค่าธรรมเนียม 100 บาทต่อเดือน และต้องแจ้งล่วงหน้าอย่างน้อย 7 วัน</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="การพักเพราะเหตุผลทางการแพทย์">
      <data key="d0">การพักเพราะเหตุผลทางการแพทย์</data>
      <data key="d1">method</data>
      <data key="d2">การพักสมาชิกที่ไม่ต้องเสียค่าธรรมเนียม แต่ต้องแนบใบรับรองแพทย์ และสามารถพักได้นานสุด 6 เดือน</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="ค่าธรรมเนียม 100 บาทต่อเดือน">
      <data key="d0">ค่าธรรมเนียม 100 บาทต่อเดือน</data>
      <data key="d1">data</data>
      <data key="d2">ค่าธรรมเนียมที่ต้องชำระเมื่อขอพักสมาชิกแบบปกติ จ่ายครั้งเดียวขณะแจ้งพัก</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="ค่าธรรมเนียมยกเลิก 1,500 บาท">
      <data key="d0">ค่าธรรมเนียมยกเลิก 1,500 บาท</data>
      <data key="d1">data</data>
      <data key="d2">ค่าธรรมเนียมที่ต้องจ่ายหากยกเลิกสมาชิกแบบรายเดือนสัญญา 12 เดือนก่อนครบสัญญา</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="ค่าธรรมเนียมยกเลิก 500 บาท">
      <data key="d0">ค่าธรรมเนียมยกเลิก 500 บาท</data>
      <data key="d1">data</data>
      <data key="d2">ค่าธรรมเนียมที่ต้องจ่ายหากยกเลิกสมาชิกนักเรียน/นักศึกษา ก่อนครบ 6 เดือน</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791178329</data>
      <data key="d6" />
    </node>
    <node id="แจ้งล่วงหน้า 7 วัน">
      <data key="d0">แจ้งล่วงหน้า 7 วัน</data>
      <data key="d1">method</data>
      <data key="d2">ข้อกำหนดในการแจ้งพักสมาชิกที่ต้องทำล่วงหน้าอย่างน้อย 7 วันก่อนวันเริ่มพัก</data>
      <data key="d3">KB-05-chunk-000</data>
      <data key="d4">KB-05</data>
      <data key="d5">1791178329</data>
