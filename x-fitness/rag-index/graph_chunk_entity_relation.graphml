  <data key="d1">person</data>
  <data key="d2">ผู้ใช้บริการที่สมัครแพ็กเกจอื่นนอกเหนือจากแพ็กเกจหลัก สามารถพาเพื่อนมาใช้บริการได้</data>
  <data key="d3">KB-05-chunk-002</data>
  <data key="d4">KB-05</data>
  <data key="d5">1791104232</data>
  <data key="d6"></data>
</node>
<node id="การชำระเงิน">
  <data key="d0">การชำระเงิน</data>
  <data key="d1">concept</data>
  <data key="d2">กระบวนการหรือการกระทำที่เกี่ยวข้องกับการจ่ายเงินเพื่อแลกกับสินค้า บริการ หรือหนี้สิน&lt;SEP&gt;กระบวนการที่ลูกค้าใช้ในการจ่ายเงินสำหรับบริการหรือผลิตภัณฑ์ โดยมีหลายช่องทางที่ร้านเอ็กซ์ ฟิตเนสยอมรับ</data>
  <data key="d3">KB-06-chunk-000&lt;SEP&gt;KB-06-chunk-002</data>
  <data key="d4">KB-06</data>
  <data key="d5">1791104257</data>
  <data key="d6"></data>
</node>
