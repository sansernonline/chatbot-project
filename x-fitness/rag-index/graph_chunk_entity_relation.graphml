    <node id="พระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 (PDPA)">
      <data key="d0">พระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 (PDPA)</data>
      <data key="d1">concept</data>
      <data key="d2">กฎหมายที่ควบคุมการเก็บ ใช้ และเปิดเผยข้อมูลส่วนบุคคลของบุคคลในประเทศไทย</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
    </node>
    <node id="โซนเวท">
      <data key="d0">โซนเวท</data>
      <data key="d1">location</data>
      <data key="d2">พื้นที่เฉพาะในยิมที่ใช้สำหรับการออกกำลังกายด้วยอุปกรณ์หนัก เช่น ดัมเบล และเครื่องยกน้ำหนัก</data>
      <data key="d3">KB-08-chunk-000</data>
      <data key="d4">KB-08</data>
      <data key="d5">1791091444</data>
      <data key="d6" />
