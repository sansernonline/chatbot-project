    <node id="เป็นเอกสารยืนยันความพร้อม">
      <data key="d0">เป็นเอกสารยืนยันความพร้อม</data>
      <data key="d3">KB-04-chunk-002</data>
      <data key="d2">ใบรับรองแพทย์เป็นเอกสารที่ใช้ยืนยันว่าบุคคลมีความพร้อมทางการแพทย์ในการเข้าร่วมโปรแกรมการฝึกอบรม</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">KB-04</data>
      <data key="d5">1791178278</data>
      <data key="d6" />
