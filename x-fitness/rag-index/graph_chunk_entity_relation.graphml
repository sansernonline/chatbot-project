  <data key="d6"></data>
</node>
<node id="โปรโมชันตอนอัปเกรด">
  <data key="d0">โปรโมชันตอนอัปเกรด</data>
  <data key="d1">concept</data>
  <data key="d2">กิจกรรมส่งเสริมการขายที่อนุญาตให้ผู้ใช้ได้รับส่วนลดหรือสิทธิพิเศษเมื่ออัปเกรดแพ็กเกจ&lt;SEP&gt;สิทธิประโยชน์พิเศษที่สามารถใช้ได้เมื่ออัปเกรดแพ็กเกจ ตามเงื่อนไขของโปรโมชันนั้น</data>
  <data key="d3">KB-02-chunk-002&lt;SEP&gt;KB-02-chunk-003</data>
  <data key="d4">KB-02</data>
  <data key="d5">1791103963</data>
  <data key="d6"></data>
</node>
