      <data key="d0">ร้าน</data>
      <data key="d1">organization</data>
      <data key="d2">หน่วยงานที่ให้บริการฟิตเนสและรับชำระเงินจากลูกค้า ซึ่งมีชื่อว่า บจก. เอ็กซ์ ฟิตเนส</data>
      <data key="d3">KB-06-chunk-000&lt;SEP&gt;KB-08-chunk-001</data>
