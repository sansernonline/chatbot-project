  <data key="d0">การอัปเกรดแพ็กเกจ</data>
  <data key="d1">method</data>
  <data key="d2">กระบวนการเปลี่ยนแปลงแพ็กเกจจากแบบรายวันหรือรายเดือนไปเป็นแพ็กเกจรายปีหรือสัญญา 12 เดือน</data>
  <data key="d3">KB-02-chunk-002</data>
  <data key="d4">KB-02</data>
  <data key="d5">1791103963</data>
  <data key="d6"></data>
</node>
<node id="การเปลี่ยนแพ็กเกจ">
  <data key="d0">การเปลี่ยนแพ็กเกจ</data>
  <data key="d1">method</data>
  <data key="d2">กระบวนการเปลี่ยนจากแพ็กเกจที่มีสัญญาไปยังแพ็กเกจที่มีราคาต่ำกว่า โดยใช้เงื่อนไขเดียวกับการยกเลิกสมาชิก</data>
  <data key="d3">KB-02-chunk-002</data>
  <data key="d4">KB-02</data>
