# X Fitness Chatbot — ค่าตั้งของ backend
# คัดลอกไฟล์นี้เป็น backend/.env แล้วใส่ค่า · ห้าม commit .env (.gitignore กันไว้แล้ว)

# ── Typhoon (จำเป็น) — ตอบแชต อ่านภาพ สร้างดัชนี · ขอ key ที่ https://playground.opentyphoon.ai
TYPHOON_API_KEY=
# XF_CHAT_MODEL=typhoon-v2.5-30b-a3b-instruct
# XF_VISION_MODEL=typhoon-ocr

# ── LINE Official Account (ไม่บังคับ) — เว้นว่าง = ปิดช่องทาง LINE (webhook ตอบ 503)
# LINE Developers Console (https://developers.line.biz/console/) → Provider → channel ของ OA
#   แท็บ Basic settings → Channel secret
#   แท็บ Messaging API  → Channel access token (long-lived) → Issue
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── หลังบ้าน /admin — เปลี่ยนรหัสก่อนเปิดให้คนนอกเข้า
# XF_ADMIN_USER=admin
# XF_ADMIN_PASS=1234

# ── จำกัดการใช้งาน (ปกติไม่ต้องแก้) — นับในหน่วยความจำ รีสตาร์ตแล้วเริ่มใหม่
# XF_RATE_LIMIT_PER_MIN=30     # ข้อความต่อนาที ต่อ IP (หน้าเว็บ) หรือต่อผู้ใช้ LINE
# XF_VISION_LIMIT_PER_MIN=6    # ภาพต่อนาที ต่อ IP
# XF_VERIFY_MAX_FAILS=5        # เบอร์ 4 ตัวท้ายผิดกี่ครั้งต่อรหัสสมาชิก (รวมทุกแชต) …
# XF_VERIFY_LOCK_MIN=15        # … แล้วล็อกรหัสนั้นกี่นาที
# XF_CORS_ORIGINS=*            # บน Render ตั้งเป็น https://x-fitness-chatbot.onrender.com (render.yaml)

# ── LightRAG (ปกติไม่ต้องแก้) — embedding แบบ hashing ของคำไทย + กลุ่มตัวอักษร + คำพ้อง (data/db/synonyms.json) ไม่ใช้ key ไม่ใช้โมเดล
# ใส่ XF_EMBED_API_KEY (เช่น key ของ Gemini) เฉพาะถ้าต้องการค้นตามความหมาย · เปลี่ยนแล้วดัชนีสร้างใหม่ทั้งหมด
# XF_EMBED_API_KEY=
# XF_RAG_MODE=mix
# XF_RAG_LLM_MAX_TOKENS=8192
# XF_RAG_CHUNK_TOKENS=500
