# copy to backend/.env (never commit .env)
# Typhoon: chat, vision (typhoon-ocr) and LightRAG indexing — https://playground.opentyphoon.ai
TYPHOON_API_KEY=
# XF_CHAT_MODEL=typhoon-v2.5-30b-a3b-instruct
# XF_VISION_MODEL=typhoon-ocr

# LightRAG embeddings: built-in character n-gram hashing — no key, no model. Leave this empty.
# Optional: an embedding API (Gemini by default) for meaning-based search; the index is rebuilt when this changes.
XF_EMBED_API_KEY=
# XF_RAG_MODE=mix
# XF_RAG_LLM_MAX_TOKENS=8192
# XF_RAG_CHUNK_TOKENS=500

# admin login — change it before putting the site on the internet
# LINE Official Account (Messaging API) — from LINE Developers console → your channel
# Basic settings → Channel secret · Messaging API → Channel access token (long-lived)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# XF_ADMIN_USER=admin
# XF_ADMIN_PASS=1234
